# ===== 服务 =====
# 监听端口
PORT=3030
# 子路径部署：与其他服务共用同一 nginx 站点、按 /lucky-wheel/ 访问时设为 /lucky-wheel
# （API 与静态资源随此前缀挂载；nginx 侧 location /lucky-wheel/ 透传前缀、勿剥离）
#BASE_PATH=/lucky-wheel
# 反向代理（Caddy/nginx）终止 TLS 时设为 true：从 X-Forwarded-For 取真实客户端 IP 用于频控与追溯
TRUST_PROXY=false
# 公网 HTTPS 部署时设为 true：会话 Cookie 追加 Secure 标记
HTTPS_ONLY=false

# ===== 管理员 =====
# 登录账号；ADMIN_PASSWORD 不设置时首次启动随机生成并打印一次
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=请设置为至少 8 位的强密码

# ===== 会话 =====
# 公网部署必须更换为随机长字符串（会话签名密钥）
SESSION_SECRET=please-change-this-secret

# ===== 数据 =====
# SQLite 数据文件路径（目录不存在会自动创建）
DB_PATH=data/lucky.db

# ===== 抽奖防刷 =====
# 单人两次抽奖最小间隔（毫秒），防手抖连点
MIN_DRAW_INTERVAL_MS=3000
# 同一 IP 每小时抽奖次数上限，防脚本批量刷奖
MAX_DRAWS_PER_IP_PER_HOUR=60

# ===== 邮件 =====
# true 或 SMTP 配置不完整时进入演练模式：邮件只打印日志，状态记为 simulated
MAIL_DRY_RUN=true
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# 发件人展示地址，缺省使用 SMTP_USER
MAIL_FROM=
